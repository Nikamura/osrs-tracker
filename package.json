{
  "name": "osrs-quest-tracker",
  "version": "1.1.0",
  "description": "Static OSRS progress dashboard backed by WikiSync, official hiscores, and OSRS Wiki metadata",
  "main": "data_fetcher.js",
  "type": "module",
  "scripts": {
    "fetch-data": "node data_fetcher.js",
    "generate": "node generate_static.js",
    "start": "node server.js",
    "cleanup": "node cleanup_player_data.js",
    "cleanup:dry-run": "node cleanup_player_data.js --dry-run",
    "cron": "npm run fetch-data && npm run cleanup && npm run generate",
    "fetch-combat-achievements": "node fetch_combat_achievements.js",
    "fetch-collection-log": "node fetch_collection_log.js",
    "fetch-sea-charting": "node fetch_sea_charting.js",
    "fetch-music-tracks": "node fetch_music_tracks.js",
    "fetch-quests": "node fetch_quests.js",
    "fetch-game-data": "npm run fetch-combat-achievements && npm run fetch-collection-log && npm run fetch-sea-charting && npm run fetch-music-tracks && npm run fetch-quests",
    "assets:brand": "./scripts/render_brand_assets.sh",
    "test": "node --test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "express": "5.2.1",
    "helmet": "8.3.0",
    "jsdom": "30.0.1"
  }
}
